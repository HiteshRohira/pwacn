{
  "name": "pwacn",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.8",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @pwacn/playground dev",
    "dev:docs": "pnpm --filter @pwacn/docs dev",
    "dev:kitchen-sink": "pnpm --filter @pwacn/kitchen-sink dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "e2e": "playwright test",
    "ux:capture": "node scripts/capture-ux.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
